# MongoDB connection string and database name (required)
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=crisisos_dev

# Generate a unique random value for each environment (required).
JWT_SECRET=replace-with-a-long-random-secret

# Optional. Without this, the backend uses deterministic AI triage fallback.
EMERGENT_LLM_KEY=

# Optional demo-account passwords. Set unique values for local development.
DEMO_CITIZEN_PASSWORD=
DEMO_RESPONDER_PASSWORD=
DEMO_OPERATOR_PASSWORD=
DEMO_ADMIN_PASSWORD=

# Optional settings
CRISISOS_DEMO_MODE=true
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
